{
    "permissions": {
    "allow": [
      "Bash(pnpm verify)",
      "Bash(pnpm format:check)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm deps:check)",
      "Bash(pnpm unused)",
      "Bash(pnpm dupes)",
      "Bash(pnpm --filter:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(pnpm bench:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree remove:*)",
      "Bash(git worktree list)",
      "Bash(gh auth status)",
      "Bash(gh repo view:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh label list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(node .claude/scripts/push-branch.mjs:*)",
      "Bash(git fetch origin)",
      "Bash(git fetch origin --prune)",
      "Bash(git switch --no-track -c:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git merge origin/main)",
      "Bash(git rev-parse:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh label create:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr comment:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(pnpm changeset publish:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./fixtures/**)",
      "Write(./fixtures/**)",
      "Edit(./.claude/settings.json)",
      "Write(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)",
      "Write(./.claude/hooks/**)",
      "Edit(./.claude/scripts/**)",
      "Write(./.claude/scripts/**)",
      "Edit(./.claude/loop-settings.json)",
      "Write(./.claude/loop-settings.json)",
      "Bash(gh issue close:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh repo delete:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/test-guard.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\""
          }
        ]
      }
    ]
  }
}
