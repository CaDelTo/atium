{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "pkg:check": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "bench": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@atium/cli#test": {
      "dependsOn": ["^build", "build"],
      "outputs": ["coverage/**"]
    },
    "@atium/cli#bench": {
      "dependsOn": ["^build", "build"],
      "cache": false
    },
    "@atium/example-playwright-demo#test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
