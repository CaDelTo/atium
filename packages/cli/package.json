{
  "name": "@atium/cli",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Command line interface of Atium.",
  "type": "module",
  "bin": {
    "atium": "./dist/bin.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "bench": "vitest bench --run",
    "pkg:check": "publint"
  },
  "dependencies": {
    "@atium/core": "workspace:*",
    "commander": "15.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@atium/storage-sqlite": "workspace:*",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.2",
    "fast-check": "4.10.2",
    "publint": "0.3.24",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
