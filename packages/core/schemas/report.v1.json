{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "toolVersion": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "analyzer": {
            "type": "string",
            "minLength": 1
          },
          "ruleId": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "reliability",
              "maintainability",
              "selectors",
              "assertions",
              "network",
              "coverage-gap",
              "architecture"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "rule",
              "heuristic",
              "llm"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "column": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "file"
            ],
            "additionalProperties": false
          },
          "testId": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "evidence": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "suggestion": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "diff": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "description"
            ],
            "additionalProperties": false
          },
          "docsUrl": {
            "type": "string",
            "format": "uri"
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "baselineState": {
            "type": "string",
            "enum": [
              "new",
              "unchanged"
            ]
          }
        },
        "required": [
          "fingerprint",
          "analyzer",
          "ruleId",
          "severity",
          "category",
          "source",
          "confidence",
          "message",
          "baselineState"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "overall": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "new": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "total",
            "new"
          ],
          "additionalProperties": false
        },
        "bySeverity": {
          "type": "object",
          "properties": {
            "error": {
              "type": "object",
              "properties": {
                "total": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "new": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "total",
                "new"
              ],
              "additionalProperties": false
            },
            "warning": {
              "type": "object",
              "properties": {
                "total": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "new": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "total",
                "new"
              ],
              "additionalProperties": false
            },
            "info": {
              "type": "object",
              "properties": {
                "total": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "new": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "total",
                "new"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "error",
            "warning",
            "info"
          ],
          "additionalProperties": false
        },
        "byRule": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ruleId": {
                "type": "string",
                "minLength": 1
              },
              "total": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "new": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "ruleId",
              "total",
              "new"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "overall",
        "bySeverity",
        "byRule"
      ],
      "additionalProperties": false
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "shortDescription": {
            "type": "string",
            "minLength": 1
          },
          "docsUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "id",
          "name",
          "shortDescription"
        ],
        "additionalProperties": false
      }
    },
    "skippedAnalyzers": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "analyzer": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "enum": [
                  "missing-capabilities"
                ]
              },
              "missing": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "history",
                    "network",
                    "dom",
                    "traces",
                    "coverage",
                    "git",
                    "openapi"
                  ]
                }
              }
            },
            "required": [
              "analyzer",
              "reason",
              "missing"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "analyzer": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "enum": [
                  "duplicate-id",
                  "invalid-config",
                  "timeout",
                  "failed",
                  "aborted"
                ]
              }
            },
            "required": [
              "analyzer",
              "reason"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "toolVersion",
    "findings",
    "summary",
    "rules",
    "skippedAnalyzers"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "title": "Atium report (schemaVersion 1)",
  "description": "Findings of an analysis with their state against the baseline, a summary, the rules and the skipped analyzers (ADR-0027). docsUrl only accepts http and https URLs, which this schema does not check. Findings are in the order of compareFindings, and rules, summary.byRule and skippedAnalyzers are sorted; this schema does not check the order or the counts."
}
