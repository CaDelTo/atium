{
  "name": "@atium/core",
  "version": "0.0.0",
  "private": true,
  "description": "Data model, configuration, pipeline and shared building blocks for Atium.",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./pure": {
      "import": {
        "types": "./dist/pure/index.d.ts",
        "default": "./dist/pure/index.js"
      },
      "require": {
        "types": "./dist/pure/index.d.cts",
        "default": "./dist/pure/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./test-contracts": {
      "import": {
        "types": "./dist/test-contracts/index.d.ts",
        "default": "./dist/test-contracts/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "bench": "vitest bench --run",
    "pkg:check": "publint && attw --pack . --profile node16 --exclude-entrypoints ./test-contracts",
    "schema:export": "vitest run src/model/json-schema.test.ts --update"
  },
  "dependencies": {
    "env-ci": "11.2.0",
    "fastest-levenshtein": "1.0.16",
    "jiti": "2.7.0",
    "picocolors": "1.1.1",
    "simple-git": "4.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.2",
    "fast-check": "4.10.2",
    "publint": "0.3.24",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
